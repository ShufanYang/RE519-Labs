      <aliases enabled='yes' />
      <column caption='Rent Burden' datatype='real' default-format='p0.0%' name='[Calculation_2108380739788800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([med_rent]*12)/[med_income]' />
      </column>
      <column caption='Burden Category' datatype='string' name='[Calculation_2108380740124673]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_2108380739788800])THEN &quot;No data&quot;&#13;&#10;ELSEIF [Calculation_2108380739788800] &gt;= 0.30 THEN &quot;High (30%+)&quot;&#13;&#10;ELSEIF [Calculation_2108380739788800] &gt;= 0.20 THEN &quot;Moderate (20–30%)&quot;&#13;&#10;ELSE &quot;Low (&lt;20%)&quot;&#13;&#10;END' />
      </column>
